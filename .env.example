# Copy this file to .env and fill in your values.
# .env is gitignored and must never be committed.

# AWS named profile configured via `aws configure sso`
AWS_PROFILE=your-sso-profile-name

# AWS region
AWS_DEFAULT_REGION=eu-central-1

# S3 bucket provided by AWS
HACKATHON_BUCKET=your-s3-bucket-name

# S3 prefix for match data — no trailing slash.
# Check the exact folder name in your bucket; the default below matches the challenge structure.
CHALLENGE_PREFIX=Challenge 2 – Unlock the Power of 3D Football Data/Match_Data

# Bedrock model id
# Use an inference profile ID, not the bare model ID — on-demand invocation is not supported.
# eu.amazon.nova-lite-v1:0 is the recommended default for eu-central-1 (no SCP restrictions).
# If your account has Anthropic model access, you can use: eu.anthropic.claude-sonnet-4-6
BEDROCK_MODEL_ID=eu.amazon.nova-lite-v1:0

# Bedrock region
BEDROCK_REGION=eu-central-1
