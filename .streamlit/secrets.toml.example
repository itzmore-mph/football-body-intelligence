# Streamlit Community Cloud secrets configuration.
# Copy this structure into the Streamlit Cloud "Secrets" settings panel.
# Do NOT commit the real secrets.toml file.
#
# Note: The hackathon account uses SSO temporary credentials.
# The aws_session_token is required and expires after ~60 minutes.
# Refresh with: aws configure export-credentials --profile slalom_IsbUsersPS-603974305500 --format env

[aws]
bucket = "hackathon-data-603974305500"
results_prefix = "results"
aws_access_key_id = "ASIA..."
aws_secret_access_key = "your-secret-key-here"
aws_session_token = "your-session-token-here"
region_name = "eu-central-1"
